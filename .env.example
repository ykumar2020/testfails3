# At least one provider key enables autonomous model evaluation.
OPENAI_API_KEY=
TESTFAILS_OPENAI_MODEL=
TESTFAILS_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
TESTFAILS_GEMINI_MODEL=
TESTFAILS_GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional OpenAI-compatible provider.
TESTFAILS_COMPAT_API_KEY=
TESTFAILS_COMPAT_BASE_URL=
TESTFAILS_COMPAT_MODEL=
TESTFAILS_COMPAT_NAME=compatible
TESTFAILS_COMPAT_EMBEDDING_MODEL=

# Optional local Hugging Face/TGI OpenAI-compatible server.
TESTFAILS_LOCAL_HF_BASE_URL=
TESTFAILS_LOCAL_HF_MODEL=
TESTFAILS_LOCAL_HF_API_KEY=
TESTFAILS_LOCAL_HF_EMBEDDING_MODEL=

# Protects the optional deployed manual-run endpoint if it is enabled later.
TESTFAILS_ADMIN_TOKEN=
